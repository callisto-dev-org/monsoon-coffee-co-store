# Keep the build context small and never bake secrets/artifacts into images.
**/node_modules
**/.next
apps/backend/.medusa
apps/backend/dist
apps/backend/static
**/dist
**/build
**/coverage

# Secrets / local env
**/.env
**/.env.*
!**/.env.template
env/*.env

# Tooling / VCS / docs
.git
.github
.turbo
.vercel
.claude
**/*.log
**/.DS_Store
