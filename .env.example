# ──────────────────────────────────────────────────────────────────────────────
# Compose-level variables. On the VPS this lives at /opt/monsoon/.env and is
# auto-loaded by `docker compose` for ${...} substitution in
# docker-compose.prod.yml. Copy to /opt/monsoon/.env and fill in.
# ──────────────────────────────────────────────────────────────────────────────

# GHCR owner (lowercase GitHub user/org that owns the pushed images).
GHCR_OWNER=siddid-soni
# Image tag to run. CI pushes :latest, so leave as latest for normal deploys.
IMAGE_TAG=latest

# Postgres credentials — must match the DATABASE_URL in env/backend.env.
POSTGRES_USER=monsoon
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=monsoon
