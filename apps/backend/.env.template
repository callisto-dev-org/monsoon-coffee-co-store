# ────────────────────────────────────────────────────────────────────────────
# Medusa core
# ────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/monsoon-coffee-co-store
DB_NAME=medusa-backend
REDIS_URL=redis://localhost:6379

JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Comma-separated origins allowed to hit the store / admin / auth APIs.
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# ────────────────────────────────────────────────────────────────────────────
# Storefront integration
# ────────────────────────────────────────────────────────────────────────────
# Base URL of the Next.js storefront. Used by PhonePe to build the
# post-payment return link.
STOREFRONT_URL=http://localhost:8000

# Backend pings this URL on product create/update/delete so Next.js drops
# cached product data. Secret must match the storefront's value.
STOREFRONT_REVALIDATE_URL=http://localhost:8000/api/revalidate
STOREFRONT_REVALIDATE_SECRET=change-me-revalidate-secret

# ────────────────────────────────────────────────────────────────────────────
# PhonePe PG v2  (https://business.phonepe.com/develop/api-integration)
# ────────────────────────────────────────────────────────────────────────────
# "sandbox" → api-preprod.phonepe.com (UAT keys)
# "production" → api.phonepe.com (live keys)
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

# Configure these on the webhook in the PhonePe dashboard, pointing it at
# {BACKEND_URL}/hooks/payment/pp_phonepe_phonepe
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ────────────────────────────────────────────────────────────────────────────
# Shipmozo (fulfillment / shipping aggregator) — https://shipmozo.com
# Docs: https://shipping-api.com/app/api/v1
# ────────────────────────────────────────────────────────────────────────────
SHIPMOZO_ENV=sandbox

# Get these from Shipmozo panel → user profile, or call POST /login with your
# panel username + password.
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=

# Warehouse id from Shipmozo (GET /get-warehouses, or create via POST
# /create-warehouse). Used as the `warehouse_id` on /push-order to identify
# which of your pickup locations ships the order. Leave blank to use the
# account's default warehouse.
SHIPMOZO_WAREHOUSE_ID=

# Origin pincode used when quoting rates at checkout. Should match the
# warehouse above.
SHIPMOZO_WAREHOUSE_PINCODE=

# Optional: lock rate-calculator quotes to a single courier id. When unset,
# the cheapest serviceable courier from /rate-calculator is used.
SHIPMOZO_DEFAULT_COURIER_ID=

# Rate-calculator defaults (rarely changed).
# SPS = Single Parcel Shipment. ROV_OWNER = customer owns the value-of-goods
# risk. See the Shipmozo dashboard if unsure.
SHIPMOZO_PACKAGE_TYPE=SPS
SHIPMOZO_ROV_TYPE=ROV_OWNER

# Default return reason id used by /push-return-order. Look up via
# /get-return-reason. e.g. 9 = "Item is damaged", 14 = "Other".
SHIPMOZO_RETURN_REASON_ID=14

# Package defaults used when a variant has no dimensions configured.
# Weight in grams, dimensions in cm.
SHIPMOZO_DEFAULT_WEIGHT_G=500
SHIPMOZO_DEFAULT_LENGTH_CM=15
SHIPMOZO_DEFAULT_BREADTH_CM=10
SHIPMOZO_DEFAULT_HEIGHT_CM=10

# Comma-separated list of Medusa payment provider IDs that should be
# treated as Cash-on-Delivery when sending the order to Shipmozo. Match is
# case-insensitive and exact. When unset, any provider id matching the
# regex /cod|cash[-_ ]?on[-_ ]?delivery/i is treated as COD.
# Example: pp_system_default,pp_manual
SHIPMOZO_COD_PAYMENT_PROVIDER_IDS=

# ────────────────────────────────────────────────────────────────────────────
# Contact / newsletter notifications
# ────────────────────────────────────────────────────────────────────────────
# Where storefront "Contact Us" messages and newsletter-signup alerts are sent.
# If unset, the email subscribers no-op (data is still stored & visible in the
# admin "Messages" page).
STORE_OWNER_EMAIL=

# Optional: configure SendGrid for real email delivery. When SENDGRID_API_KEY
# is set, the "email" channel routes through SendGrid; otherwise emails are just
# logged to the backend console by the local notification provider.
# SENDGRID_FROM must be a verified sender. The subscribers reference SendGrid
# dynamic templates "contact-admin-notification" / "newsletter-admin-notification".
SENDGRID_API_KEY=
SENDGRID_FROM=
