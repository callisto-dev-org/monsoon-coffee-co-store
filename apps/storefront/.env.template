# ────────────────────────────────────────────────────────────────────────────
# Medusa backend connection
# ────────────────────────────────────────────────────────────────────────────
# Server-side URL the storefront uses to talk to Medusa. Used by middleware
# and server components/actions.
MEDUSA_BACKEND_URL=http://localhost:9000

# Client-side fallback. Exposed to the browser, so only set this if you
# actually need browser-side calls to hit the backend directly.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key for the storefront sales channel. Create one in the
# Medusa admin: Settings → Publishable API Keys.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Default region code used by middleware when no region cookie is set.
NEXT_PUBLIC_DEFAULT_REGION=in

# ────────────────────────────────────────────────────────────────────────────
# Storefront URLs
# ────────────────────────────────────────────────────────────────────────────
# Public base URL of this storefront (used for absolute links, OG tags, etc.).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Used by next-sitemap to generate sitemap.xml.
NEXT_PUBLIC_VERCEL_URL=http://localhost:8000

# ────────────────────────────────────────────────────────────────────────────
# Revalidation webhook (called by the backend on product changes)
# ────────────────────────────────────────────────────────────────────────────
# Must match STOREFRONT_REVALIDATE_SECRET in apps/backend/.env
STOREFRONT_REVALIDATE_SECRET=change-me-revalidate-secret

# ────────────────────────────────────────────────────────────────────────────
# Redis cache (server-side caching for Medusa responses)
# ────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_CACHE_NAMESPACE=monsoon:sf
REDIS_CACHE_TTL_SECONDS=300

# ────────────────────────────────────────────────────────────────────────────
# Next.js image domains (only needed when serving product images from S3)
# ────────────────────────────────────────────────────────────────────────────
# e.g. my-bucket.s3.amazonaws.com
MEDUSA_CLOUD_S3_HOSTNAME=
# e.g. /my-bucket
MEDUSA_CLOUD_S3_PATHNAME=

# ────────────────────────────────────────────────────────────────────────────
# Build / analysis
# ────────────────────────────────────────────────────────────────────────────
# Set to "true" to enable @next/bundle-analyzer during `pnpm build`.
ANALYZE=false
