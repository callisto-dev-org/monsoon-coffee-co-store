# ──────────────────────────────────────────────────────────────────────────────
# Backend runtime env. On the VPS this lives at /opt/monsoon/env/backend.env
# (NEVER committed). Copy from this file and fill in real values.
# Keys mirror apps/backend/.env.template; only production-specific notes below.
# ──────────────────────────────────────────────────────────────────────────────

# Internal service hostnames (Docker network). User/pass/db must match the
# POSTGRES_* values in /opt/monsoon/.env.
DATABASE_URL=postgres://monsoon:change-me-strong-password@postgres:5432/monsoon
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-long-random
COOKIE_SECRET=change-me-long-random

# Public origins (replace example.com with your domain). No trailing slash.
STORE_CORS=https://example.com,https://www.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://api.example.com,https://example.com,https://www.example.com

# Storefront integration.
STOREFRONT_URL=https://example.com
STOREFRONT_REVALIDATE_URL=https://example.com/api/revalidate
# Must equal STOREFRONT_REVALIDATE_SECRET in env/storefront.env.
STOREFRONT_REVALIDATE_SECRET=change-me-revalidate-secret

# PhonePe (production keys; set PHONEPE_ENV=production for live).
PHONEPE_ENV=production
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Shipmozo (production).
SHIPMOZO_ENV=production
SHIPMOZO_PUBLIC_KEY=
SHIPMOZO_PRIVATE_KEY=
SHIPMOZO_WAREHOUSE_ID=
SHIPMOZO_WAREHOUSE_PINCODE=
SHIPMOZO_DEFAULT_COURIER_ID=
SHIPMOZO_PACKAGE_TYPE=SPS
SHIPMOZO_ROV_TYPE=ROV_OWNER
SHIPMOZO_RETURN_REASON_ID=14
SHIPMOZO_DEFAULT_WEIGHT_G=500
SHIPMOZO_DEFAULT_LENGTH_CM=15
SHIPMOZO_DEFAULT_BREADTH_CM=10
SHIPMOZO_DEFAULT_HEIGHT_CM=10
SHIPMOZO_COD_PAYMENT_PROVIDER_IDS=

# Contact / newsletter notifications.
STORE_OWNER_EMAIL=
SENDGRID_API_KEY=
SENDGRID_FROM=
