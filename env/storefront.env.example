# ──────────────────────────────────────────────────────────────────────────────
# Storefront RUNTIME env. On the VPS this lives at /opt/monsoon/env/storefront.env
# (NEVER committed).
#
# NOTE: all NEXT_PUBLIC_* are BUILD-TIME and are NOT set here — they are baked
# into the image by CI from GitHub Actions secrets (see .github/workflows/deploy.yml).
# Only server-side runtime vars belong in this file.
# ──────────────────────────────────────────────────────────────────────────────

# Server-side backend URL (internal Docker network hostname).
MEDUSA_BACKEND_URL=http://backend:9000

# Must equal STOREFRONT_REVALIDATE_SECRET in env/backend.env.
STOREFRONT_REVALIDATE_SECRET=change-me-revalidate-secret

# Server-side response cache.
REDIS_URL=redis://redis:6379
REDIS_CACHE_NAMESPACE=monsoon:sf
REDIS_CACHE_TTL_SECONDS=300
